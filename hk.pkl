amends "package://github.com/jdx/hk/releases/download/v2.5.0/hk@2.5.0#/Config.pkl"

local checks = new Mapping<String, Step> {
  ["gofmt"] {
    glob = "**/*.go"
    check = "test -z \"$(gofmt -l {{files}})\""
    fix = "gofmt -w {{files}}"
  }
  ["go-mod-tidy"] {
    glob = "**/*.go"
    check = "go mod tidy -diff"
    fix = "go mod tidy"
    stage = List("go.mod", "go.sum")
  }
  ["golangci-lint"] {
    glob = "**/*.go"
    check = "golangci-lint run ./..."
  }
}

steps = checks

hooks {
  ["pre-push"] {
    steps {
      ["test"] { check = "go test ./..." }
      ["build"] { check = "go build ./..." }
    }
  }
}
