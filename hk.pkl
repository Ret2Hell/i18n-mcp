amends "package://github.com/jdx/hk/releases/download/v1.58.1/hk@1.58.1#/Config.pkl"

local checks = new Mapping<String, Step> {
  ["gofmt"] {
    glob = "**/*.go"
    check = "test -z \"$(gofmt -l {{files}})\""
    fix = "gofmt -w {{files}}"
  }
  ["go-mod-tidy"] {
    glob = "**/*.go"
    check = "go mod tidy -diff"
    fix = "go mod tidy"
    stage = List("go.mod", "go.sum")
  }
  ["golangci-lint"] {
    glob = "**/*.go"
    check = "golangci-lint run ./..."
  }
}

hooks {
  ["pre-commit"] {
    fix = true
    stash = "git"
    steps = checks
  }
  ["pre-push"] {
    steps {
      ["test"] { check = "go test ./..." }
      ["build"] { check = "go build ./..." }
    }
  }
  ["check"] { steps = checks }
  ["fix"] {
    fix = true
    steps = checks
  }
}
