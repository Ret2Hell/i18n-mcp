amends "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Config.pkl"

import "package://github.com/jdx/hk/releases/download/v2.8.1/hk@2.8.1#/Builtins.pkl"

local checks = new Mapping<String, Step> {
  ["gofmt"] = Builtins.go_fmt
  ["go-mod-tidy"] {
    glob = List("**/*.go", "go.mod", "go.sum")
    depends = "gofmt"
    check = "go mod tidy -diff"
    fix = "go mod tidy"
    stage = List("go.mod", "go.sum")
  }
  ["golangci-lint"] = (Builtins.golangci_lint) {
    glob = List("**/*.go", "go.mod", "go.sum", ".golangci.yml")
    depends = "go-mod-tidy"
    // Lint the whole module without rewriting files outside the selected set.
    fix = check
  }
  ["merge-conflict"] = Builtins.check_merge_conflict
  ["private-key"] = Builtins.detect_private_key
}

steps = checks

hooks {
  ["pre-commit"] {
    steps {
      ["gitleaks"] = (Builtins.gitleaks) {
        scan = "staged"
      }
    }
  }
  ["commit-msg"] {
    steps {
      ["conventional-commit"] = Builtins.check_conventional_commit
    }
  }
  ["pre-push"] {
    steps {
      ["test"] { check = "go test ./..." }
      ["build"] { check = "go build ./..." }
    }
  }
}
